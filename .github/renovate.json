{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)ARG[ \\t]+CALCARDBACKUP_VERSION=(?<currentValue>[^ \\t\\r\\n#]+)"
      ],
      "depNameTemplate": "BernieO/calcardbackup",
      "packageNameTemplate": "BernieO/calcardbackup",
      "datasourceTemplate": "forgejo-tags",
      "registryUrlTemplate": "https://codeberg.org",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [".github/workflows/**"],
      "pinDigests": false
    },
    {
      "matchFileNames": ["**/docker-compose*-example.yml"],
      "pinDigests": false
    },
    {
      "description": "Automerge non-major Dockerfile updates",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge Dockerfile digest updates",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge stable minor and patch updates for approved linting and security scanner GitHub Actions",
      "matchFileNames": [".github/workflows/**"],
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "super-linter/super-linter",
        "ShiftLeftSecurity/scan-action",
        "goodwithtech/dockle-action",
        "aquasecurity/trivy-action",
        "anchore/scan-action"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "matchNewValue": "!/-/",
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
